Structure dossiers Expo (recommandée)

	/app
		_layout.tsx          (root, auth check, theme)
		(index).tsx         (redirect dashboard ou login)
		/(tabs)/
			_dayout.tsx     (bottom tabs)
			index.tsx       (Dashboard)
			feed.tsx
			events.tsx
			events/[id].tsx
			groups.tsx
			groups/[id].tsx
			profile.tsx
		/conversations.tsx
		/chat/[id].tsx
		/login.tsx
		/register.tsx
		/notifications.tsx
		/settings.tsx
		/admin/             (si rôle admin)
		/university-admin/
		/class-leader/
	/components
	/services      (api, auth, events, feed, groups, messaging, notifications, user)
	/store         (zustand ou context)
	/hooks
	/utils
	/constants

