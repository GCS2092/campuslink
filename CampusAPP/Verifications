## Modification 4 — Push notifications (nouveau endpoint)

C'est la seule vraie **nouvelle fonctionnalité** à ajouter. Flutter va enregistrer le device de l'utilisateur auprès de FCM/APNs et te donner un token de device — tu dois le stocker côté Django pour pouvoir envoyer des notifications push.

```python
# notifications/models.py — ajouter ce modèle
from django.db import models
from django.conf import settings

class DeviceToken(models.Model):
    PLATFORM_CHOICES = [('android', 'Android'), ('ios', 'iOS')]

    user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        on_delete=models.CASCADE,
        related_name='device_tokens'
    )
    token = models.CharField(max_length=500, unique=True)
    platform = models.CharField(max_length=10, choices=PLATFORM_CHOICES)
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

    class Meta:
        unique_together = ('user', 'token')
```

```python
# notifications/views.py — ajouter ces 2 endpoints
from rest_framework.views import APIView
from rest_framework.response import Response
from rest_framework.permissions import IsAuthenticated
from .models import DeviceToken

class RegisterDeviceTokenView(APIView):
    permission_classes = [IsAuthenticated]

    def post(self, request):
        token = request.data.get('token')
        platform = request.data.get('platform')  # 'android' ou 'ios'

        if not token or not platform:
            return Response({'error': 'token et platform requis'}, status=400)

        # Créer ou mettre à jour (un user peut avoir plusieurs devices)
        DeviceToken.objects.update_or_create(
            user=request.user,
            token=token,
            defaults={'platform': platform}
        )
        return Response({'status': 'token enregistré'})

    def delete(self, request):
        # Appelé au logout — supprimer le token du device
        token = request.data.get('token')
        DeviceToken.objects.filter(user=request.user, token=token).delete()
        return Response({'status': 'token supprimé'})

# notifications/urls.py
urlpatterns = [
    path('device-token/', RegisterDeviceTokenView.as_view(), name='device-token'),
]
```

