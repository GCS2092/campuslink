flutter upgrade
flutter doctor -v

# Créer le projet (tout sur une ligne, PowerShell ne supporte pas \)
flutter create `
  --org sn.campuslink `
  --platforms ios,android `
  --template app `
  --overwrite `
  --description "CampusLink - Plateforme etudiante" `
